{% capture email_title %}Reset your password{% endcapture %}

<!DOCTYPE html>
<html lang="en">
<head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600&display=swap');
    body, table, td, p, a { font-family: 'Work Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif; }
    body { margin: 0; padding: 0; background-color: #FFFFFF; }
    table { border-collapse: collapse; }
    a { text-decoration: none; }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#FFFFFF;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#FFFFFF;">
    <tr>
      <td align="center" style="padding:0;">

        <!-- top accent bar -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
          <tr><td height="4" style="background-color:#990B33; font-size:4px; line-height:4px;">&nbsp;</td></tr>
        </table>

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;">

          <!-- logo -->
          <tr>
            <td align="center" style="padding:40px 24px 28px; border-bottom:1px solid #F4F4F5;">
              {%- if shop.email_logo_url %}
                <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width }}" style="display:block;">
              {%- else %}
                <a href="{{ shop.url }}" style="font-family: Georgia, 'Times New Roman', Times, serif; font-weight:700; font-size:22px; letter-spacing:1.5px; text-transform:uppercase; color:#990B33;">{{ shop.name }}</a>
              {%- endif %}
            </td>
          </tr>

          <!-- content card -->
          <tr>
            <td style="padding:40px 24px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#FAFAFA; border:1px solid #F4F4F5; border-radius:12px;">
                <tr>
                  <td align="center" style="padding:48px 40px;">

                    <p style="margin:0 0 12px; color:#990B33; font-size:11px; font-weight:600; letter-spacing:1.5px; text-transform:uppercase;">Password reset</p>

                    <p style="margin:0 0 12px; color:#09090B; font-size:26px; font-weight:500; line-height:1.24;">Forgot your password?</p>

                    <p style="margin:0 0 32px; color:#52525C; font-size:14px; line-height:1.5; max-width:340px;">No worries, it happens. Click below to choose a new password for your Gloss Up account.</p>

                    <!-- button -->
                    <table role="presentation" cellpadding="0" cellspacing="0">
                      <tr>
                        <td align="center" bgcolor="#990B33" style="border-radius:999px;">
                          <a href="{{ customer.reset_password_url | replace: shop.url, 'https://glossup.vercel.app' }}" style="display:inline-block; padding:14px 36px; color:#FFFAFA; font-size:15px; font-weight:500;">Reset password</a>
                        </td>
                      </tr>
                    </table>

                    <p style="margin:28px 0 0; color:#A1A1AA; font-size:12px; line-height:1.5; max-width:320px;">This link expires shortly. If you didn't request a password reset, you can safely ignore this email — your password won't change.</p>

                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- footer -->
          <tr>
            <td align="center" style="padding:32px 24px 40px;">
              <p style="margin:0 0 4px; color:#71717B; font-size:12px;">&copy;{{ 'now' | date: "%Y" }} Gloss Up. All rights reserved.</p>
              <p style="margin:0; color:#71717B; font-size:12px;">Need help? Email us at <a href="mailto:{{ shop.email }}" style="color:#990B33; font-weight:500;">{{ shop.email }}</a></p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
